<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/header_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/header_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Gesture card -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/gesture_card_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="10dp"
                android:text="@string/gesture_up"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="10dp"
                android:text="@string/gesture_down"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/gesture_note"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/txt_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_inactive"
                android:textColor="@color/brand_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_enable_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand_blue"
                android:text="@string/enable_service"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Live volume card -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_weight="1"
                    android:text="@string/volume_title" />

                <TextView
                    android:id="@+id/txt_volume_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="@color/brand_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progressTint="@color/brand_cyan"
                android:thumbTint="@color/brand_cyan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_minus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_dark"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_mute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/brand_purple"
                    android:text="@string/mute"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_plus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_dark"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings card -->
        <LinearLayout
            style="@style/CardBox"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/settings_title" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_gestures"
                style="@style/RowSwitch"
                android:text="@string/enable_gestures" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_haptics"
                style="@style/RowSwitch"
                android:text="@string/haptic_feedback" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_system_ui"
                style="@style/RowSwitch"
                android:text="@string/show_volume_ui" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensitivity"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txt_sensitivity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sens_medium"
                    android:textColor="@color/brand_cyan"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/brand_purple"
                android:thumbTint="@color/brand_purple" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/widget_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
